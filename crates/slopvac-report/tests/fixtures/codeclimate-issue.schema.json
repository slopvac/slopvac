{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Hand transcription of the Issues, Categories, Locations and Positions sections of https://github.com/codeclimate/platform/blob/690633cb2a08839a5bfa350ed925ddb6de55bbdc/spec/analyzers/SPEC.md. The spec defines no JSON Schema. The spec allows lines or positions per location. slopvac emits lines only (docs/contract/positions.md), because GitLab Code Quality requires lines.begin, so this schema requires lines and forbids positions. Unknown issue fields are rejected.",
  "title": "Code Climate issue",
  "type": "object",
  "required": ["type", "check_name", "description", "categories", "location"],
  "additionalProperties": false,
  "properties": {
    "type": {"const": "issue"},
    "check_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]*$"},
    "content": {"type": "object", "required": ["body"], "properties": {"body": {"type": "string"}}},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["Bug Risk", "Clarity", "Compatibility", "Complexity", "Duplication", "Performance", "Security", "Style"]}
    },
    "location": {"$ref": "#/definitions/Location"},
    "other_locations": {"type": "array", "items": {"$ref": "#/definitions/Location"}},
    "remediation_points": {"type": "integer", "minimum": 0},
    "severity": {"enum": ["info", "minor", "major", "critical", "blocker"]},
    "fingerprint": {"type": "string", "minLength": 1}
  },
  "definitions": {
    "Location": {
      "type": "object",
      "required": ["path", "lines"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lines": {
          "type": "object",
          "required": ["begin", "end"],
          "additionalProperties": false,
          "properties": {"begin": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}

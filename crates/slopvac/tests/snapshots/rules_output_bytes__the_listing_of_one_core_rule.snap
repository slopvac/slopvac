{
  "categories": [
    {
      "description": "Artifacts of the generating session that reached a shipped document. Never a style judgement: a cutoff disclaimer or a tool citation token is a defect in every genre.",
      "id": "ai-residue",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "internal",
        "change-comms"
      ],
      "title": "AI residue",
      "weight": 1.5
    },
    {
      "description": "The formulae an agent reaches for when it has to name a section and has no fact to name it with: a universal claim about a whole class, standing in for a title. The shape is the tell, not the vocabulary, so these rules match syntax and a rewritten slogan does not escape by swapping words.",
      "id": "ai-tells-agentic",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "internal",
        "change-comms"
      ],
      "title": "AI tells -- agentic slogan formulae",
      "weight": 1.5
    },
    {
      "description": "Defects in what the prose contains rather than how it is arranged: fabricated citations, fake specificity, vaporware description, dilution, and rationale nobody asked for.",
      "id": "ai-tells-content-shape",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "reference",
        "internal",
        "change-comms"
      ],
      "title": "AI tells -- content shape",
      "weight": 1.5
    },
    {
      "description": "A verb doing rhetorical work in place of an observation. The generated register reaches for a spatial or athletic metaphor where the literal relation was available: what something is, where it is, what it lacks.",
      "id": "ai-tells-figurative",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "internal",
        "change-comms"
      ],
      "title": "AI tells -- figurative verbs",
      "weight": 1.2
    },
    {
      "description": "Markup and punctuation tells. These decay slowly, but em-dash suppression shipped in late-2025 frontier models, so ABSENCE proves nothing while density still signals.",
      "id": "ai-tells-formatting",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "reference",
        "internal",
        "change-comms"
      ],
      "title": "AI tells -- formatting and punctuation",
      "weight": 1.0
    },
    {
      "description": "The chat-assistant voice that survived lexical patching. Each entry is a voice, not a word: synonym-swapping does not remove it. Per-model fingerprints inside this register drift fast, so treat model attributions as snapshots.",
      "id": "ai-tells-register",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "reference",
        "internal",
        "change-comms"
      ],
      "title": "AI tells -- the chat-assistant register",
      "weight": 1.5
    },
    {
      "description": "Structure tells endure across model generations because preference training produces them: raters reward length, markdown, bulleted symmetry, and confident even-handedness, so every generation reconverges on the same shapes even as the vocabulary changes. Weight these above any word list.",
      "id": "ai-tells-structure",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "reference",
        "internal",
        "change-comms"
      ],
      "title": "AI tells -- rhetorical structure",
      "weight": 1.5
    },
    {
      "description": "Deterministic consumer-document rules: describe the released artifact at HEAD, with no status claims, delta narration, or internal references. Change communications, migrations, decision records, plans/specs, and historical reports are routed to their own genres rather than judged by these consumer-doc rules.",
      "id": "docs-discipline",
      "plugin": "core",
      "recommended_for": [
        "consumer"
      ],
      "title": "Docs discipline",
      "weight": 1.0
    },
    {
      "description": "Objective restatements of the six rules from \"Politics and the English Language\" (1946), plus extensions the essay warrants.",
      "id": "orwell",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "reference",
        "internal",
        "change-comms",
        "informal"
      ],
      "title": "Orwell's rules, modernized",
      "weight": 1.5
    },
    {
      "description": "Every rule here restores a deleted actor. An abstraction promoted to subject, a machine granted a mind, a passive with the agent removed, a recommendation with nobody behind it.",
      "id": "prose-agency",
      "plugin": "core",
      "recommended_for": [
        "consumer",
        "internal",
        "change-comms"
      ],
      "title": "Prose agency",
      "weight": 1.2
    },
    {
      "description": "Mechanical craft defects with one correct answer and no house-style position: article agreement, initialism form, link text, directional references, tense, spacing, wordiness. Most are accessibility or copy-edit rules rather than generated-text signals.",
      "id": "prose-craft",
      "plugin": "core",
      "recommended_for": [

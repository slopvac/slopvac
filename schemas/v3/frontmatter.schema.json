{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "description": "Per-document settings. The layer sits above matching overrides and below inline directives.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "categories": {
          "$ref": "config.schema.json#/$defs/Settings/properties/categories"
        },
        "genre": {
          "$ref": "config.schema.json#/$defs/Ref"
        },
        "locale": {
          "$ref": "config.schema.json#/$defs/Settings/properties/locale"
        },
        "profile": {
          "$ref": "config.schema.json#/$defs/Settings/properties/profile"
        },
        "rules": {
          "$ref": "config.schema.json#/$defs/Settings/properties/rules"
        },
        "terms": {
          "additionalProperties": false,
          "description": "Words this document uses its own way.",
          "patternProperties": {
            "^x-": true
          },
          "properties": {
            "allow": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "thresholds": {
          "$ref": "config.schema.json#/$defs/Settings/properties/thresholds"
        },
        "v": {
          "$ref": "common.schema.json#/$defs/SchemaVersion",
          "description": "Version of this block's shape. Same number as the config schema_version."
        }
      },
      "required": [
        "v"
      ],
      "type": "object"
    }
  },
  "$id": "https://slopvac.github.io/slopvac/schemas/v3/frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A document's front matter mapping, after YAML, TOML or JSON parsing. Only the `slopvac` key belongs to slopvac; every other key is the document's own and is not validated. Unknown keys inside `slopvac` are errors, and keys that start with `x-` are ignored. The project's `[frontmatter] allow` list narrows which fields take effect. Semantics: docs/contract/config.md.",
  "properties": {
    "slopvac": {
      "$ref": "#/$defs/Block"
    }
  },
  "title": "slopvac v3 front matter",
  "type": "object"
}

{
  "$defs": {
    "CategoryOutput": {
      "additionalProperties": false,
      "description": "A category as the listing shows it: the metadata of a category file without its rules and without `schema_version`.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "description": {
          "description": "What the category covers.",
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "type": "string"
        },
        "plugin": {
          "$ref": "common.schema.json#/$defs/PackId",
          "description": "The plugin that ships the category."
        },
        "recommended_for": {
          "description": "Genres this category suits.",
          "items": {
            "$ref": "rule.schema.json#/$defs/Genre"
          },
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "description": "Display title.",
          "minLength": 1,
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "description": "Contribution to the overall score before any config override.",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "plugin",
        "title",
        "description",
        "weight",
        "recommended_for"
      ],
      "type": "object"
    },
    "EffectiveSeverity": {
      "description": "The level a rule runs at after the configuration layers. The set is closed, because gate and score logic depend on these values. `off` means the configuration disables the rule, which a shipped rule never does.",
      "enum": [
        "suggestion",
        "warning",
        "error",
        "off"
      ]
    },
    "ExplainOutput": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "kind": {
                    "const": "judgement"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "cases": {
                "maxItems": 0
              },
              "exceptions": {
                "maxItems": 0
              },
              "severity": {
                "const": "suggestion"
              }
            }
          }
        }
      ],
      "description": "The document that `slopvac explain RULE --format json` prints: a rule entry with `schema_version` and, when the rule has an exception, the comment that suppresses it.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "ai_signal": {
          "description": "How strongly a finding indicates machine-written text.",
          "enum": [
            "strong",
            "weak",
            "none"
          ]
        },
        "ai_signal_source": {
          "description": "Where the `ai_signal` value comes from.",
          "enum": [
            "measured",
            "catalog",
            "unmeasured"
          ]
        },
        "allowlist": {
          "description": "Literal strings that never fire, even when the match holds.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "applies_to": {
          "$ref": "rule.schema.json#/$defs/AppliesTo"
        },
        "cases": {
          "items": {
            "$ref": "rule.schema.json#/$defs/Case"
          },
          "type": "array"
        },
        "category": {
          "description": "The category that holds the rule.",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "type": "string"
        },
        "citation": {
          "$ref": "rule.schema.json#/$defs/Citation"
        },
        "contexts": {
          "$ref": "rule.schema.json#/$defs/Contexts"
        },
        "effective_severity": {
          "$ref": "#/$defs/EffectiveSeverity"
        },
        "examples": {
          "items": {
            "$ref": "rule.schema.json#/$defs/Example"
          },
          "type": "array"
        },
        "exceptions": {
          "items": {
            "$ref": "rule.schema.json#/$defs/Exception"
          },
          "type": "array",
          "uniqueItems": true
        },
        "exclude_blocks": {
          "items": {
            "$ref": "rule.schema.json#/$defs/BlockKind"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fix": {
          "description": "The rewrite operation, as guidance.",
          "type": "string"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/RuleId"
        },
        "kind": {
          "$ref": "#/$defs/MatchKind"
        },
        "match": {
          "$ref": "rule.schema.json#/$defs/Match"
        },
        "message": {
          "description": "Shown on a finding. Names the fix, not the violation. {match} and {replacement} interpolate.",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "Short imperative label.",
          "minLength": 1,
          "type": "string"
        },
        "plugin": {
          "$ref": "common.schema.json#/$defs/PackId",
          "description": "The plugin that supplies the rule. It is the part of `id` before the colon."
        },
        "schema_version": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "scope": {
          "$ref": "rule.schema.json#/$defs/Scope"
        },
        "severity": {
          "$ref": "common.schema.json#/$defs/Severity",
          "description": "The level the rule ships with."
        },
        "severity_from": {
          "description": "The configuration source that set the effective severity, such as `project slopvac.toml:4:1`. Present when the configuration set it, including to the level the rule ships with.",
          "minLength": 1,
          "type": "string"
        },
        "suppression": {
          "description": "The `slopvac-allow` comment that suppresses the rule, naming the rule and its first exception.",
          "minLength": 1,
          "type": "string"
        },
        "text_type": {
          "$ref": "rule.schema.json#/$defs/TextType"
        },
        "url": {
          "description": "The documentation page of the rule. Absent when the rule has none.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "message",
        "severity",
        "scope",
        "text_type",
        "match",
        "ai_signal",
        "ai_signal_source",
        "citation",
        "category",
        "plugin",
        "kind",
        "effective_severity",
        "schema_version"
      ],
      "type": "object"
    },
    "MatchKind": {
      "description": "The kind of the rule's match, as `--kind` names it. It repeats `match.kind`.",
      "enum": [
        "tokens",
        "pattern",
        "substitution",
        "metric",
        "structure",
        "capitalization",
        "vocabulary",
        "judgement"
      ],
      "x-slopvac-extensible": true
    },
    "RuleOutput": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "kind": {
                    "const": "judgement"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "match"
            ]
          },
          "then": {
            "properties": {
              "cases": {
                "maxItems": 0
              },
              "exceptions": {
                "maxItems": 0
              },
              "severity": {
                "const": "suggestion"
              }
            }
          }
        }
      ],
      "description": "One entry of the `rules` list.",
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "ai_signal": {
          "description": "How strongly a finding indicates machine-written text.",
          "enum": [
            "strong",
            "weak",
            "none"
          ]
        },
        "ai_signal_source": {
          "description": "Where the `ai_signal` value comes from.",
          "enum": [
            "measured",
            "catalog",
            "unmeasured"
          ]
        },
        "allowlist": {
          "description": "Literal strings that never fire, even when the match holds.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "applies_to": {
          "$ref": "rule.schema.json#/$defs/AppliesTo"
        },
        "cases": {
          "items": {
            "$ref": "rule.schema.json#/$defs/Case"
          },
          "type": "array"
        },
        "category": {
          "description": "The category that holds the rule.",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])",
          "type": "string"
        },
        "citation": {
          "$ref": "rule.schema.json#/$defs/Citation"
        },
        "contexts": {
          "$ref": "rule.schema.json#/$defs/Contexts"
        },
        "effective_severity": {
          "$ref": "#/$defs/EffectiveSeverity"
        },
        "examples": {
          "items": {
            "$ref": "rule.schema.json#/$defs/Example"
          },
          "type": "array"
        },
        "exceptions": {
          "items": {
            "$ref": "rule.schema.json#/$defs/Exception"
          },
          "type": "array",
          "uniqueItems": true
        },
        "exclude_blocks": {
          "items": {
            "$ref": "rule.schema.json#/$defs/BlockKind"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fix": {
          "description": "The rewrite operation, as guidance.",
          "type": "string"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/RuleId"
        },
        "kind": {
          "$ref": "#/$defs/MatchKind"
        },
        "match": {
          "$ref": "rule.schema.json#/$defs/Match"
        },
        "message": {
          "description": "Shown on a finding. Names the fix, not the violation. {match} and {replacement} interpolate.",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "Short imperative label.",
          "minLength": 1,
          "type": "string"
        },
        "plugin": {
          "$ref": "common.schema.json#/$defs/PackId",
          "description": "The plugin that supplies the rule. It is the part of `id` before the colon."
        },
        "scope": {
          "$ref": "rule.schema.json#/$defs/Scope"
        },
        "severity": {
          "$ref": "common.schema.json#/$defs/Severity",
          "description": "The level the rule ships with."
        },
        "severity_from": {
          "description": "The configuration source that set the effective severity, such as `project slopvac.toml:4:1`. Present when the configuration set it, including to the level the rule ships with.",
          "minLength": 1,
          "type": "string"
        },
        "text_type": {
          "$ref": "rule.schema.json#/$defs/TextType"
        },
        "url": {
          "description": "The documentation page of the rule. Absent when the rule has none.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "message",
        "severity",
        "scope",
        "text_type",
        "match",
        "ai_signal",
        "ai_signal_source",
        "citation",
        "category",
        "plugin",
        "kind",
        "effective_severity"
      ],
      "type": "object"
    }
  },
  "$id": "https://slopvac.github.io/slopvac/schemas/v3/rules-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The document that `slopvac rules --format json` prints. `slopvac explain RULE --format json` prints one entry of its `rules` list, described by `$defs/ExplainOutput`. Rule entries carry the qualified rule id and the facts the binary adds to the authoring shape in rule.schema.json: the category, the match kind, the documentation link and the severity after the configuration layers. This is an output document, so it is not valid input for a rule or category file. Unknown keys are errors, and keys that start with `x-` are ignored.",
  "patternProperties": {
    "^x-": true
  },
  "properties": {
    "categories": {
      "description": "Every category the catalogue loads, in catalogue order. A filter on the rules does not shorten this list.",
      "items": {
        "$ref": "#/$defs/CategoryOutput"
      },
      "type": "array"
    },
    "plugin": {
      "$ref": "common.schema.json#/$defs/PackId",
      "description": "The first plugin in `plugins`, or `core` when the list is empty."
    },
    "plugins": {
      "description": "The plugins that own the listed rules, in catalogue order, each once.",
      "items": {
        "$ref": "common.schema.json#/$defs/PackId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "rules": {
      "description": "The rules that pass the filters, in catalogue order.",
      "items": {
        "$ref": "#/$defs/RuleOutput"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    }
  },
  "required": [
    "schema_version",
    "plugin",
    "plugins",
    "categories",
    "rules"
  ],
  "title": "slopvac v3 rules output",
  "type": "object"
}

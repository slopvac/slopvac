{
  "protocolVersion": 1,
  "minProtocolVersion": 1,
  "hostInfo": {
    "name": "slopvac",
    "version": "3.0.0"
  },
  "capabilities": {
    "hooks": [
      "tagger",
      "extractor",
      "reporter",
      "fixer",
      "scorer",
      "provider",
      "recipe"
    ],
    "features": [
      "document-path"
    ]
  },
  "offline": false,
  "limits": {
    "maxMessageBytes": 16777216,
    "maxBatchDocuments": 64
  }
}

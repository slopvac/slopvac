{
  "description": "Cap vectors for binary extractor output (plugin-protocol.md section 5.5.5). The caps are fixed host constants, not negotiated. Each case describes one document result: segments is the segment count, text_bytes_each the UTF-8 length of every segment text, and part_length and locator_length the character count of every part and locator. A case within every cap is accepted. A case over a cap fails that document with binary-budget (-32010), and data.cap names the cap. The shared validator (slopvac-8l4.20.1) builds each result and replays the file; part and locator cases also agree with the schema pattern bound.",
  "caps": {
    "segments": 1000000,
    "text-bytes": 33554432,
    "part-length": 1024,
    "locator-length": 1024
  },
  "cases": [
    {
      "id": "segments-at-cap",
      "segments": 1000000,
      "text_bytes_each": 33,
      "part_length": 17,
      "locator_length": 8,
      "expected": "accepted"
    },
    {
      "id": "segments-over-cap",
      "segments": 1000001,
      "text_bytes_each": 1,
      "part_length": 17,
      "locator_length": 8,
      "expected": {
        "code": "binary-budget",
        "error": -32010,
        "cap": "segments"
      }
    },
    {
      "id": "text-at-cap",
      "segments": 2,
      "text_bytes_each": 16777216,
      "part_length": 17,
      "locator_length": 8,
      "expected": "accepted"
    },
    {
      "id": "text-over-cap",
      "segments": 2,
      "text_bytes_each": 16777217,
      "part_length": 17,
      "locator_length": 8,
      "expected": {
        "code": "binary-budget",
        "error": -32010,
        "cap": "text-bytes"
      }
    },
    {
      "id": "part-at-cap",
      "segments": 1,
      "text_bytes_each": 1,
      "part_length": 1024,
      "locator_length": 8,
      "expected": "accepted"
    },
    {
      "id": "part-over-cap",
      "segments": 1,
      "text_bytes_each": 1,
      "part_length": 1025,
      "locator_length": 8,
      "expected": {
        "code": "binary-budget",
        "error": -32010,
        "cap": "part-length"
      }
    },
    {
      "id": "locator-at-cap",
      "segments": 1,
      "text_bytes_each": 1,
      "part_length": 17,
      "locator_length": 1024,
      "expected": "accepted"
    },
    {
      "id": "locator-over-cap",
      "segments": 1,
      "text_bytes_each": 1,
      "part_length": 17,
      "locator_length": 1025,
      "expected": {
        "code": "binary-budget",
        "error": -32010,
        "cap": "locator-length"
      }
    }
  ]
}
